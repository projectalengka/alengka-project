# Koneksi PostgreSQL.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Lokal:
DATABASE_URL="postgresql://postgres:password@localhost:5432/design_studio"
#
# Neon (gratis, untuk online):
#   Dashboard Neon -> Connect -> pilih "Direct connection" (BUKAN pooled),
#   lalu tempel di sini. Yang dibutuhkan adalah varian DIRECT, karena
#   `prisma migrate deploy` tidak bisa lewat connection pooler.
#
#   Contoh bentuknya:
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/design_studio?sslmode=require"
#
# Kalau nanti trafiknya naik dan koneksi serverless mulai menumpuk, baru
# pindah ke connection pooler:
#   - DATABASE_URL  = varian "Pooled connection" (+ ?pgbouncer=true)
#   - DIRECT_URL    = varian "Direct connection"
#   dan tambahkan `directUrl = env("DIRECT_URL")` di blok datasource
#   prisma/schema.prisma supaya migrasi tetap lewat jalur langsung.
