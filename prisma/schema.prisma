generator client {
  provider = "prisma-client-js"

  /// Vercel menjalankan fungsi serverless di Amazon Linux (glibc, OpenSSL 3.0).
  /// Tanpa target ini, Prisma Client yang di-generate bisa tidak menemukan query
  /// engine saat runtime dan gagal dengan "Query engine binary for current
  /// platform could not be found". `native` tetap disertakan untuk pemakaian lokal.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Status proyek sebagai enum, bukan String bebas.
/// Sebelumnya nilai apa pun bisa tersimpan, dan satu typo membuat proyek
/// hilang dari semua filter tanpa error.
enum ProjectStatus {
  On_Progress
  Revisi
  Done
  Cancel
}

model Project {
  id           String        @id @default(uuid())
  clientName   String
  projectTitle String
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price        Float
  status       ProjectStatus @default(On_Progress)
  deadline     DateTime
  notes        String        @default("") @db.Text
  previewImage String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@index([deadline])
  @@map("projects")
}

model Category {
  id       String    @id
  name     String    @unique
  iconName String    @default("Tag")
  projects Project[]

  @@map("categories")
}
